generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Baris url = env("DATABASE_URL") DIHAPUS
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  day         Int
  location    String
  description String   @db.Text
  image       String
  price       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}