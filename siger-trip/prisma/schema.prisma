generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// 1. MODEL UTAMA: Paket Wisata SigerTrip
model Package {
  id           String        @id @default(cuid())
  title        String        // Contoh: "3 Hari Keliling Kuliner di Bandar Lampung"
  duration     Int           // Contoh: 3
  category     String        // Contoh: "Kuliner", "Alam", "Perkotaan"
  description  String        @db.Text
  basePrice    String        // Contoh: "Rp 350.000"
  image        String        // Banner utama paket
  destinations Destination[] // Relasi: 1 Paket memiliki banyak titik pemberhentian/itinerary
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
}

// 2. MODEL TIMELINE: Titik Pemberhentian Aktivitas Harian
model Destination {
  id          String   @id @default(cuid())
  packageId   String   // Foreign Key penghubung ke Package
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name        String   // Nama Tempat (Bisa pantai, restoran, atau hotel)
  category    String   // PENTING: Diisi "Wisata", "Kuliner", atau "Penginapan"
  day         Int      // Hari ke-berapa aktivitas ini dilakukan (1, 2, 3, dst)
  location    String   // Alamat titik lokasi
  description String   @db.Text
  image       String   // Foto lokasi
  price       String   // Estimasi biaya (Tiket masuk / Harga makan / Tarif hotel)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}